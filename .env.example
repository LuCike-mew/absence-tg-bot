# Telegram Bot token from @BotFather
BOT_TOKEN=your_token_here

# Your Telegram user ID (for /broadcast admin access)
# Get it from @userinfobot
ADMIN_USER_ID=123456789

# Encryption key for database (auto-generated on first run if absent)
# Keep this key safe — if lost, existing absence data becomes unreadable
# ENCRYPTION_KEY=

# Optional: URL of the Web App (defaults to the deployed GitHub Pages app)
# WEB_APP_URL=https://lucike-mew.github.io/absence-webapp/

# Optional: use mock schedule instead of real parsing (true/false)
# USE_MOCK_SCHEDULE=false